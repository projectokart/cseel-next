  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>DEVENDER (Dev Sharma) \u2014 Senior Physics Faculty Resume</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\" />\n  <style>\n    @page {\n      size: A4 portrait;\n      margin: 8mm 11mm 8mm 11mm;\n    }\n    @media print {\n      body, html {\n        background: #ffffff !important;\n        padding: 0 !important;\n        margin: 0 !important;\n        -webkit-print-color-adjust: exact !important;\n        print-color-adjust: exact !important;\n      }\n      .no-print { display: none !important; }\n      #email-content-area {\n        background: #ffffff !important;\n        padding: 0 !important;\n        margin: 0 !important;\n      }\n      table[style*='max-width: 800px'],\n      table[style*='max-width: 794px'] {\n        max-width: 100% !important;\n        border: none !important;\n        box-shadow: none !important;\n        border-radius: 0 !important;\n        padding: 0 !important;\n        margin: 0 !important;\n      }\n      td.sheet-td {\n        padding: 0 !important;\n      }\n      .page-break {\n        page-break-before: always !important;\n        break-before: page !important;\n        display: block !important;\n        height: 0 !important;\n        margin: 0 !important;\n        padding: 0 !important;\n      }\n    }\n    @media only screen and (max-width: 600px) {\n      #email-content-area {\n        padding: 8px 4px !important;\n      }\n      td.sheet-td {\n        padding: 16px 12px !important;\n      }\n      .mobile-full {\n        width: 100% !important;\n        display: block !important;\n      }\n      .mobile-stack {\n        display: block !important;\n        width: 100% !important;\n      }\n      .mobile-center {\n        text-align: center !important;\n      }\n      .cert-card-col {\n        width: 50% !important;\n      }\n    }\n    body {\n      font-family: 'Plus Jakarta Sans', Arial, Helvetica, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #f8fafc;\n      color: #1e293b;\n      -webkit-font-smoothing: antialiased;\n    }\n    a {\n      text-decoration: none;\n    }\n  </style>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #f8fafc; font-family: 'Plus Jakarta Sans', Arial, Helvetica, sans-serif; color: #1e293b;\">\n\n  <!-- Email Wrapper Container -->\n  <div id=\"email-content-area\" style=\"padding: 16px 8px; background-color: #f8fafc;\">\n\n    <!-- Resume White Sheet Container (Mobile-First Responsive) -->\n    <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 780px; width: 100%; margin: 0 auto; background-color: #ffffff; border-radius: 6px; box-shadow: 0 2px 15px rgba(15, 23, 42, 0.07); border: 1px solid #e2e8f0; font-family: 'Plus Jakarta Sans', Arial, Helvetica, sans-serif; font-size: 9.2pt; line-height: 1.48; color: #1e293b;\">\n      <tr>\n        <td class=\"sheet-td\" style=\"padding: 24px 20px;\">\n\n          <!-- ================= HEADER SECTION (MOBILE-OPTIMIZED) ================= -->\n          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-bottom: 2px solid #0f2b48; padding-bottom: 12px; margin-bottom: 12px;\">\n            <tr>\n              <!-- Header Left: Candidate Info -->\n              <td valign=\"top\" style=\"padding-right: 10px;\">\n                <!-- Name & Verified Badge -->\n                <div style=\"margin-bottom: 3px;\">\n                  <span style=\"font-size: 19pt; font-weight: 800; color: #0f2b48; letter-spacing: -0.5px; line-height: 1.15;\">DEVENDER</span>\n                  <span style=\"font-weight: 500; font-size: 13pt; color: #475569; margin-left: 2px;\">(Dev Sharma)</span>\n                </div>\n                <!-- Verified Faculty Badge -->\n                <div style=\"margin-bottom: 5px;\">\n                  <span style=\"font-size: 7.4pt; font-weight: 700; color: #0f766e; background-color: #f0fdfa; border: 1px solid #ccfbf1; padding: 2px 7px; border-radius: 4px; display: inline-block; vertical-align: middle; white-space: nowrap; letter-spacing: 0.3px;\">\n                    <i class=\"fa-solid fa-circle-check\" style=\"color: #0f766e; margin-right: 3px;\"></i> VERIFIED SENIOR FACULTY\n                  </span>\n                </div>\n                <!-- Designation Focused on Physics Teaching -->\n                <div style=\"font-size: 10pt; font-weight: 700; color: #1d4ed8; margin-bottom: 6px; line-height: 1.35;\">\n                  Senior Physics Faculty (Class 11 &amp; 12 / PGT) &bull; Experiential &amp; Inquiry Pedagogy &bull; GATE Qualified\n                </div>\n                <!-- Contact Row -->\n                <div style=\"font-size: 8.2pt; color: #475569; line-height: 1.55;\">\n                  <i class=\"fa-solid fa-location-dot\" style=\"color: #0f2b48; font-size: 8pt; margin-right: 3px;\"></i> Palwal, Haryana &ndash; 121102\n                  <span style=\"display: inline-block; margin: 0 4px;\">&bull;</span>\n                  <i class=\"fa-solid fa-phone\" style=\"color: #0f2b48; font-size: 8pt; margin-right: 3px;\"></i> <a href=\"tel:+918683979659\" style=\"color: #0f2b48; text-decoration: none; font-weight: 600;\">+91 8683979659</a>\n                  <br/>\n                  <i class=\"fa-solid fa-envelope\" style=\"color: #0f2b48; font-size: 8pt; margin-right: 3px;\"></i> <a href=\"mailto:ptdevkaushik101@gmail.com\" style=\"color: #1d4ed8; text-decoration: none; font-weight: 600;\">ptdevkaushik101@gmail.com</a>\n                </div>\n              </td>\n              <!-- Header Right: Candidate Photo -->\n              <td width=\"82\" valign=\"top\" align=\"right\" style=\"width: 82px; text-align: right;\">\n                <img src=\"https://www.cseel.org/images/dev-sharma.jpg\" alt=\"Devender (Dev Sharma)\" width=\"80\" height=\"96\" style=\"width: 80px; height: 96px; object-fit: cover; border-radius: 6px; border: 1.5px solid #0f2b48; box-shadow: 0 1px 5px rgba(15, 23, 42, 0.12); display: block;\" />\n              </td>\n            </tr>\n          </table>\n\n          <!-- ================= CAREER OBJECTIVE & TEACHING PHILOSOPHY ================= -->\n          <div style=\"margin-bottom: 12px;\">\n            <div style=\"font-size: 10pt; font-weight: 800; color: #0f2b48; text-transform: uppercase; letter-spacing: 0.6px; border-bottom: 1px solid #e2e8f0; padding-bottom: 3px; margin-bottom: 6px;\">\n              <i class=\"fa-solid fa-compass\" style=\"color: #1d4ed8; font-size: 9pt; margin-right: 5px;\"></i> CAREER OBJECTIVE &amp; TEACHING PHILOSOPHY\n            </div>\n            <div style=\"font-size: 8.7pt; color: #334155; text-align: justify; line-height: 1.48; background-color: #f8fafc; padding: 9px 12px; border-left: 3px solid #0f2b48; border-radius: 0 4px 4px 0;\">\n              Dedicated and result-driven <strong>Senior Physics Faculty (Class XI &amp; XII / PGT Physics)</strong> with strong subject mastery and a deep commitment to <strong>Experiential Learning, Inquiry-Based Teaching, and Concept-First Pedagogy</strong>. Skilled in transforming complex and abstract physical concepts (Electrodynamics, Mechanics, Wave Optics, Modern Physics) into intuitive mental models through tabletop apparatus demonstrations, guided inquiry, and structured numerical problem-solving&mdash;consistently achieving <strong>90%+ concept retention</strong> and exceptional board exam results. Brings valuable institution